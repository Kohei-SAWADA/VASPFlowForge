SYSTEM = SrTiO3_cubic_5atom_hse_dos

! ---------- electronic minimisation ----------
PREC   = Accurate
ENCUT  = 520
EDIFF  = 1.0E-06
NELM   = 200

! ISTART / ICHARG: the pipeline sets these automatically.
!   WAVECAR reusable (identical KPOINTS to stage 02) -> ISTART=1, ICHARG=0
!   otherwise (safe default)                         -> ISTART=0, ICHARG=2
ISTART = 0
ICHARG = 2

ISPIN  = 1

ISMEAR = 0
SIGMA  = 0.05

! ---------- static run: no ionic steps ----------
IBRION = -1
NSW    = 0
ISIF   = 2

! ---------- functional: HSE06 ----------
GGA      = PE
LHFCALC  = .TRUE.
HFSCREEN = 0.2
AEXX     = 0.25
ALGO     = Damped
TIME     = 0.4
PRECFOCK = Fast

! ---------- accuracy helpers ----------
LREAL  = .FALSE.
LASPH  = .TRUE.
ADDGRID = .TRUE.
LMAXMIX = 4
ISYM   = 0

! ---------- DOS output ----------
LORBIT = 11
NEDOS  = 3000
EMIN   = -10
EMAX   = 10

! ---------- parallelisation (machine dependent) ----------
! USER_CHECK_REQUIRED: tune for your workstation.
! KPAR  = 2
! NCORE = 4

LWAVE  = .FALSE.
LCHARG = .TRUE.
